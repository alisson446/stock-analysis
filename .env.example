# Copie para .env e ajuste. O .env é gitignored.
# Guardam os dados que MUDAM com o tempo e que o yfinance NÃO fornece.
# Se um valor for omitido, o código usa o default indicado.

# --- Macro (premissas do custo de capital) ---
# Taxa livre de risco nominal: título longo do governo BR (média 5a). Default: 0.124
RISK_FREE_RATE=0.124
# Prêmio de risco de mercado BR (ERP). Default: 0.075
EQUITY_RISK_PREMIUM=0.075

# --- Estimativas forward (analistas via yfinance) ---
# Liga o uso de crescimento forward no estágio 1 do DCF.
# 1/true/yes/on = ligado. Default: 0 (usa CAGR histórico).
# Quando ligado e o yfinance não tiver estimativa para um papel, cai de volta
# no CAGR histórico automaticamente.
USE_FORWARD_ESTIMATES=0
# Qual crescimento alimenta o estágio 1 do DCF quando o forward está ligado:
# 'revenue' (receita, default) ou 'earnings' (lucro). O DCF projeta fluxo de
# caixa livre, que é receita menos custos e investimentos — mais próximo de
# receita que de lucro contábil, e o lucro oscila muito mais para a mesma
# variação de receita. Valor inválido cai no default com aviso impresso.
FORWARD_GROWTH_DRIVER=revenue

# --- Macro por moeda (ativos estrangeiros) ---
# BRL e USD já sobem configurados no código; as linhas abaixo só existem para
# você ajustar os valores. Qualquer OUTRA moeda precisa das duas variáveis, e
# até lá o papel que reporta nela é excluído com log dizendo o que falta.
# Ex.: para habilitar a Europa, acrescente RISK_FREE_RATE_EUR e
# EQUITY_RISK_PREMIUM_EUR.
# Taxa livre de risco em dólar: Treasury longo. Default: 0.042
RISK_FREE_RATE_USD=0.042
# Prêmio de risco de mercado EUA. Default: 0.045
EQUITY_RISK_PREMIUM_USD=0.045

# --- Região a analisar ---
# O notebook roda UMA região por execução. Default: br
#
#   br  ações brasileiras, listadas via dadosdemercado.com.br
#   us  ações americanas, alcançadas pelos BDRs de B3 e avaliadas em dólar
#
# Cada região tem o seu cache em data/<REGION>/ e os seus critérios em
# config/<REGION>/filters.json, então trocar de região não mistura nada:
# rodar 'us' não toca no histórico de 'br'.
#
# Para comparar as duas, rode uma de cada vez e leia os dois
# valuation_history.csv — a margem de segurança é adimensional e comparável
# entre moedas sem nenhuma cotação.
REGION=br
